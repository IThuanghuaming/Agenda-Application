{
  "name": "agenda-application",
  "version": "1.0.0",
  "private": true,
  "description": "采用前后端分离 MVC 架构的本地全栈待办事项应用",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {}
}